<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_ai_config"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="2dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/btn_back_to_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#333333"
                android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 智能配置"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:id="@+id/root_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section: Provider Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 基础设置"
                android:textColor="#1A73E8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ai_input_modern"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 提供商"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>
                <Spinner
                    android:id="@+id/spinner_providers"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner_rounded"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 接口地址"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/et_api_url"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="https://api.example.com"
                    android:background="@drawable/bg_search_box"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 令牌 (API Key)"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/et_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="输入您的 API Key"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_search_box"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_conn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="刷新并测试模型连接"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    android:backgroundTint="#E3F2FD"
                    android:textColor="#1976D2"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BBDEFB"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
            </LinearLayout>

            <!-- Section: Mode Specific Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="业务模型与提示词"
                android:textColor="#1A73E8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ai_input_modern"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented_container"
                    android:padding="2dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/btn_single_prompt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="单笔记账"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#1A73E8"
                        android:background="@drawable/bg_segmented_selected"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_multi_prompt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="多笔账单"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_receipt_prompt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="小票记账"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btn_rule_prompt"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="规则生成"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="系统提示词 (Prompt)"
                        android:textColor="#666666"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tv_edit_prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="启用编辑"
                        android:textSize="12sp"
                        android:textColor="#F44336"
                        android:padding="4dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackground"/>

                    <TextView
                        android:id="@+id/tv_toggle_expand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="展开内容"
                        android:textSize="12sp"
                        android:textColor="#1A73E8"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackground"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <EditText
                        android:id="@+id/et_custom_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="单笔模式默认提示词..."
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:textColor="#444444"/>
                    <EditText
                        android:id="@+id/et_multi_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="多账单模式默认提示词..."
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                    <EditText
                        android:id="@+id/et_rule_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="规则生成模式默认提示词..."
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                    <EditText
                        android:id="@+id/et_receipt_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="小票记账模式默认提示词..."
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前模式使用模型"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>
                <Spinner
                    android:id="@+id/spinner_models"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner_rounded"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:text="恢复默认提示词"
                    android:textSize="11sp"
                    android:textColor="#757575"
                    app:strokeColor="#DDDDDD"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_config"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="保存所有配置"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#2E7D32"
                android:layout_marginBottom="40dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
