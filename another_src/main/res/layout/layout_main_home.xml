<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp">

        <!-- 顶部标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="翻转记账"
                android:textColor="#333333"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textColor="#999999"
                android:textSize="13sp"
                android:background="#E0E0E0"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 1. 顶部状态卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#5C6BC0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="即刻开启记账"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="授予悬浮窗权限后，即可使用翻转记账功能。"
                    android:textColor="#E8EAF6"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestOverlay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. 授予权限"
                        android:textColor="#FFFFFF"
                        app:rippleColor="#FFFFFF" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="8dp"
                        android:background="#80FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowOverlay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. 开启悬浮窗"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:rippleColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================================ -->
        <!-- 2. 数据与偏好 -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="数据与偏好"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Prompt 调试 -->
                <LinearLayout
                    android:id="@+id/btn_prompt_debug"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛠️   查看当前 Prompt 相关数据源"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="50dp" android:background="#F5F5F5" />

                <!-- 资产账户管理 -->
                <LinearLayout
                    android:id="@+id/btn_manage_assets"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💳   资产账户管理"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="50dp" android:background="#F5F5F5" />

                <!-- 收支分类管理 -->
                <LinearLayout
                    android:id="@+id/btn_manage_categories"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏷️   收支分类管理"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="50dp" android:background="#F5F5F5" />

                <!-- 多币种与汇率 -->
                <LinearLayout
                    android:id="@+id/btn_manage_currencies"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💱   多币种与汇率"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="50dp" android:background="#F5F5F5" />

                <!-- 翻转灵敏度调节 -->
                <LinearLayout
                    android:id="@+id/btn_flip_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎛️   翻转灵敏度调节"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginStart="50dp" android:background="#F5F5F5" />

                <!-- 备份与恢复 -->
                <LinearLayout
                    android:id="@+id/btn_backup_restore"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💾   备份与恢复"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================================ -->
        <!-- 3. 实验室功能 -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="实验室功能"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <!-- 启用翻转手势 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_flip_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="启用翻转手势"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手机扣在桌面上再翻转至正面时自动记账"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="4dp" />

                <!-- 翻转手势子配置区域 (开启翻转后展示) -->
                <LinearLayout
                    android:id="@+id/layout_flip_sub_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <!-- 启用白名单限制（关闭 = 全局感应，开启 = 白名单模式） -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_flip_always"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:text="启用白名单限制"
                        android:textColor="#333333"
                        android:textSize="13sp"
                        app:switchPadding="12dp"
                        android:layout_marginStart="24dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="关闭时为全局感应（默认）；开启后仅在白名单应用中触发。"
                        android:textColor="#999999"
                        android:textSize="10sp"
                        android:layout_marginTop="-4dp"
                        android:layout_marginStart="24dp"
                        android:paddingBottom="6dp" />

                    <!-- 触发应用白名单按钮，仅在白名单限制开启时显示 -->
                    <LinearLayout
                        android:id="@+id/btn_manage_whitelist"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginStart="16dp"
                        android:paddingEnd="0dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🛡️   管理触发应用白名单"
                            android:textColor="#5C6BC0"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="#5C6BC0" />
                    </LinearLayout>

                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F5F5F5" android:layout_marginVertical="4dp" />

                <!-- 弹窗震动反馈 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_vibrate_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="弹窗震动反馈"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="翻转成功弹出记账面板时提供触觉震动反馈"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F5F5F5" android:layout_marginVertical="4dp" />

                <!-- 隐身模式 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_hide_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="隐身模式"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="在系统最近任务列表(多任务)中隐藏此App"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================================ -->
        <!-- 4. AI 与智能功能 -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="AI 与智能功能"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <!-- 启用 AI 功能 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_show_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="启用 AI 功能"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <!-- AI 功能展开区域 -->
                <LinearLayout
                    android:id="@+id/layout_ai_main_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:id="@+id/divider_ai"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F5F5F5"
                        android:layout_marginBottom="4dp" />

                    <!-- 多账单模式 -->
                    <LinearLayout
                        android:id="@+id/layout_multi_bill_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_show_multi_bill"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp"
                            android:text="开启多账单模式"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:switchPadding="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="一次性输入多条信息。模式开启后，点击识别按钮将应用多账单提示词。"
                            android:textColor="#999999"
                            android:textSize="10sp"
                            android:layout_marginTop="-4dp"
                            android:layout_marginStart="12dp"
                            android:paddingBottom="4dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_multi_bill_not_sync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp"
                            android:text="不验证直接批量保存"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:switchPadding="12dp"
                            android:layout_marginStart="24dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="多账单识别结果将优先存入本地账单列表，方便后续核对或批量同步。"
                            android:textColor="#999999"
                            android:textSize="10sp"
                            android:layout_marginTop="-4dp"
                            android:layout_marginStart="36dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F5F5F5" android:layout_marginVertical="4dp"
                        android:layout_marginStart="8dp" />

                    <!-- 语音功能开关 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_show_voice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:text="开启语音功能"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <!-- ASR 引擎选择，缩进在语音功能开关下面 -->
                    <LinearLayout
                        android:id="@+id/layout_asr_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="识别引擎"
                            android:textColor="#666666"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/spinner_asr_mode"
                            android:layout_width="140dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_spinner_rounded"
                            android:entries="@array/asr_modes" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_asr_model_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="12dp"
                        android:baselineAligned="false"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="模型信息"
                            android:textColor="#666666"
                            android:textSize="14sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_delete_offline_model"
                            android:layout_width="140dp"
                            android:layout_height="32dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#F4F6F8"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#E0E4E8">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:foreground="?attr/selectableItemBackground">

                                <TextView
                                    android:id="@+id/tv_asr_model_desc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="硅基流动"
                                    android:textColor="#4CAF50"
                                    android:textStyle="bold"
                                    android:textSize="11sp" />
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F5F5F5" android:layout_marginVertical="8dp" />

                    <!-- 图片记账功能开关 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_show_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:text="开启图片记账功能"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        app:switchPadding="16dp" />

                    <!-- OCR 引擎选择，缩进在图片功能开关下面 -->
                    <LinearLayout
                        android:id="@+id/layout_ocr_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="识别引擎"
                            android:textColor="#666666"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/spinner_ocr_mode"
                            android:layout_width="140dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_spinner_rounded"
                            android:entries="@array/ocr_modes" />
                    </LinearLayout>

                    <!-- 小票语言模式选择，缩进在图片功能开关下面 -->
                    <LinearLayout
                        android:id="@+id/layout_receipt_lang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="32dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="小票语言"
                            android:textColor="#666666"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/spinner_receipt_lang"
                            android:layout_width="160dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_spinner_rounded"
                            android:entries="@array/receipt_lang_modes" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F5F5F5" android:layout_marginVertical="8dp" />

                    <!-- AI 配置入口按钮 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_manage_ai_rules"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="管理专属记账习惯 ➡️"
                        android:textColor="#5C6BC0"
                        app:rippleColor="#205C6BC0"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_detailed_config"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="🤖  AI 详细配置 (API/模型/提示词)"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        app:backgroundTint="#673AB7"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================================ -->
        <!-- 5. 高级留存配置 -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="高级留存配置"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <!-- 多币种显示 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_show_multi_cur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="显示 多币种 选项"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F5F5F5" android:layout_marginVertical="4dp" />

                <!-- 强力唤醒锁 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_permanent_wakelock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="强力唤醒锁 (防杀)"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="保持CPU唤醒，极度耗电但强制保活传感器。"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F5F5F5" android:layout_marginVertical="4dp" />

                <!-- Shizuku 终极保活 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_shizuku_persistence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Shizuku 终极保活"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="使用Shizuku隐藏API维持服务常驻，无视系统查杀。"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="4dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F5F5F5" android:layout_marginVertical="4dp" />

                <!-- 开发者日志 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_logging"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="开发者日志"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_logs"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:text="查看日志内容 ->"
                    android:textSize="12sp"
                    android:textColor="#5C6BC0"
                    android:visibility="gone"
                    android:padding="0dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flip Accounting"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:textColor="#DDDDDD"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>