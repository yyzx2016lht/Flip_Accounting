<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#EDF3FC" />
            <stroke
                android:width="1dp"
                android:color="#D4DFEF" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#F7FAFF" />
            <stroke
                android:width="1dp"
                android:color="#DFE8F6" />
        </shape>
    </item>
</selector>
