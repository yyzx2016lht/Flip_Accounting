<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chat_session_item_selected_bg" />
            <corners
                android:bottomLeftRadius="@dimen/chat_session_item_radius"
                android:topLeftRadius="@dimen/chat_session_item_radius"
                android:bottomRightRadius="0dp"
                android:topRightRadius="0dp" />
            <stroke
                android:width="1dp"
                android:color="@color/chat_session_item_selected_stroke" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="start|center_vertical"
        android:top="12dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#3B82F6" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
