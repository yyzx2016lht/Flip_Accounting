<resources>
    <style name="Theme.FlipAccounting" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主颜色配置 -->
        <item name="colorPrimary">#5C6BC0</item>
        <item name="colorPrimaryVariant">#3F51B5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- 次要颜色 -->
        <item name="colorSecondary">#FF4081</item>
        <item name="colorSecondaryVariant">#F50057</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">#F5F7FA</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FlipAccounting.Transparent" parent="Theme.FlipAccounting">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Animation_FlipAccounting_DialogSoft">
        <item name="android:windowEnterAnimation">@anim/dialog_soft_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_soft_exit</item>
    </style>

</resources>
