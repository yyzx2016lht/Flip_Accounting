<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/dialog_content_padding"
    android:paddingEnd="@dimen/dialog_content_padding"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/dialog_title"
        android:tag="dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="start"
        android:text="选择分类"
        android:textColor="@color/dialog_title"
        android:textSize="@dimen/dialog_title_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sort_category_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="长按图标直接拖动排序"
        android:textColor="@color/dialog_subtitle"
        android:textSize="@dimen/dialog_subtitle_size"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll_categories"
        android:layout_width="match_parent"
        android:layout_height="@dimen/overlay_picker_grid_visible_height"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sort_categories"
        android:layout_width="match_parent"
        android:layout_height="@dimen/overlay_picker_grid_visible_height"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_confirm_category"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_button_primary"
        android:text="确认"
        android:textColor="@color/dialog_button_primary_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

</LinearLayout>
