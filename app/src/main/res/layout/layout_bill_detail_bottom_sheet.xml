<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="22dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="详情"
            android:textColor="#1A1A1A"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btn_copy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="复制"
                android:textColor="#666666"
                android:textSize="@dimen/text_size_13" />

            <TextView
                android:id="@+id/btn_refund"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="退款"
                android:textColor="#666666"
                android:textSize="@dimen/text_size_13" />

            <TextView
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="修改"
                android:textColor="#666666"
                android:textSize="@dimen/text_size_13" />

            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/shape_button_outline_red"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="删除"
                android:textColor="#FF3B30"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#EEF1F4" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_detail_amount_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="金额"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_detail_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-¥0.00"
                        android:textColor="#FF3B30"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_detail_amount_formula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="退款¥0.00，实际支出¥0.00"
                        android:textColor="#A0A7B1"
                        android:textSize="@dimen/text_size_12"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 多币种转账：转入金额中间的分割线 -->
            <View
                android:id="@+id/line_incoming"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#F4F6F8"
                android:visibility="gone" />

            <!-- 多币种转账：转入金额独立行，默认隐藏 -->
            <LinearLayout
                android:id="@+id/layout_detail_incoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_detail_incoming_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="转入金额"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_incoming_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="$0.00"
                    android:textColor="#22252B"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/line_amount"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#F4F6F8" />

            <LinearLayout
                android:id="@+id/layout_detail_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="手续费"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_fee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#FF9500"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:id="@+id/line_fee_detail"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#F4F6F8"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_detail_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="分类"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:id="@+id/line_category"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#F4F6F8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_detail_account_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="账户"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#F0F0F0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_detail_time_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="时间"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#1A1A1A"
                        android:textSize="@dimen/text_size_14" />

                    <TextView
                        android:id="@+id/tv_detail_record_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#8A8A8E"
                        android:textSize="@dimen/text_size_12" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#F4F6F8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="备注"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_remark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#F4F6F8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="账本"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_book_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_15" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_refund_records_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F2F4F7"
                    android:padding="12dp"
                    android:text="退款记录"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_refund_records_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_original_bill_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F2F4F7"
                    android:padding="12dp"
                    android:text="原账单"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_original_bill_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
