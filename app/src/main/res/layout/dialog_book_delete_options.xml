<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_delete_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tv_delete_book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1F2937"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_delete_book_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="#7B8798"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/scroll_delete_book_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_delete_book_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E8EEF7" />

    <TextView
        android:id="@+id/btn_delete_book_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_delete_dialog_cancel_btn"
        android:gravity="center"
        android:minHeight="44dp"
        android:paddingHorizontal="14dp"
        android:text="@string/cancel"
        android:textColor="#5A677C"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
