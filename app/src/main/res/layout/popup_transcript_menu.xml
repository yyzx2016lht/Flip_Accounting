<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popup_transcript_menu_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_msg_popup_menu">

    <ImageView
        android:id="@+id/iv_transcript_action"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_chevron_down_small"
        android:tint="#FFFFFF" />

    <TextView
        android:id="@+id/tv_transcript_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collapse_text"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
