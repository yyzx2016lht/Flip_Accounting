<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/dialog_content_padding"
    android:paddingEnd="@dimen/dialog_content_padding"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tv_option_picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dialog_title"
        android:textSize="@dimen/dialog_title_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_option_picker_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/dialog_subtitle"
        android:textSize="@dimen/dialog_subtitle_size"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_option_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:cacheColorHint="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:listSelector="?attr/selectableItemBackground"
        android:overScrollMode="ifContentScrolls" />

    <TextView
        android:id="@+id/btn_option_picker_cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dialog_button_cancel"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/dialog_button_cancel_text"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
