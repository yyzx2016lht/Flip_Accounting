<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_chat_dialog_panel">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_chat_bg"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#25344A"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/item_bg_pick_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_action_item"
        android:text="@string/select_image"
        android:textSize="15sp"
        android:textColor="#2A3A53"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp" />

    <TextView
        android:id="@+id/item_bg_reset_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_action_item"
        android:text="@string/restore_default_bg"
        android:textSize="15sp"
        android:textColor="#2A3A53"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp" />

    <TextView
        android:id="@+id/btn_bg_setting_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/cancel"
        android:textSize="14sp"
        android:textColor="#6F7E95"
        android:paddingVertical="10dp" />

</LinearLayout>
