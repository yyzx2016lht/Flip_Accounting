<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/page_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_rule_subtle_chip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bill_item_chat"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recurring_auto_detect_tolerance_title"
            android:textColor="#111827"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/recurring_auto_detect_tolerance_hint"
            android:textColor="#7A8598"
            android:textSize="@dimen/text_size_13" />

        <EditText
            android:id="@+id/et_recurring_tolerance_value"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ai_input_field"
            android:hint="1"
            android:inputType="numberDecimal"
            android:paddingHorizontal="13dp"
            android:selectAllOnFocus="true"
            android:textColor="#111827"
            android:textColorHint="#9AA4B2"
            android:textSize="@dimen/text_size_15" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_recurring_tolerance_save"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="@string/rule_learn_confirm"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_size_14"
        app:backgroundTint="@color/brand_primary"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/btn_recurring_tolerance_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/rule_learn_cancel"
        android:textColor="#6B7280"
        android:textSize="@dimen/text_size_13" />
</LinearLayout>
