<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/dialog_content_padding"
    android:paddingEnd="@dimen/dialog_content_padding"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/multi_currency"
        android:textColor="@color/dialog_title"
        android:textSize="@dimen/dialog_title_size"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/exchange_rate_hint"
        android:textColor="@color/dialog_subtitle"
        android:textSize="@dimen/dialog_subtitle_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/from_amount"
            android:textColor="@color/dialog_picker_normal_text"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/et_source_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="end"
            android:inputType="numberDecimal"
            android:text="0.00"
            android:paddingEnd="8dp"
            android:textColor="@color/dialog_picker_normal_text"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_source_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="人民币（CNY） >"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/dialog_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exchange_rate_label"
            android:textColor="@color/dialog_picker_normal_text"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/et_exchange_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="end"
            android:inputType="numberDecimal"
            android:paddingEnd="8dp"
            android:text="1.0"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_refresh_rate"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="@color/brand_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/dialog_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transfer_amount"
                android:textColor="@color/dialog_picker_normal_text"
                android:textSize="@dimen/text_size_16" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/currency_matches_account"
                android:textColor="@color/dialog_subtitle"
                android:textSize="@dimen/text_size_10" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_target_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="end"
            android:inputType="numberDecimal"
            android:paddingEnd="8dp"
            android:text="0.00"
            android:textColor="@color/dialog_picker_normal_text"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_target_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="波兰兹罗提（PLN） >"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_formula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="4dp"
        android:text="55.00 * 1.8"
        android:textColor="@color/dialog_subtitle"
        android:textSize="@dimen/text_size_12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button_cancel"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/dialog_button_cancel_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dialog_button_primary"
            android:gravity="center"
            android:text="@string/confirm_action"
            android:textColor="@color/dialog_button_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
