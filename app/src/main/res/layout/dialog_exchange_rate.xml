<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="多币种"
        android:textColor="#000000"
        android:textSize="@dimen/text_size_20"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="汇率自动换算，同时也支持手动调整"
        android:textColor="#9E9E9E"
        android:textSize="@dimen/text_size_12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="转出金额"
            android:textColor="#333333"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/et_source_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="end"
            android:inputType="numberDecimal"
            android:text="0.00"
            android:paddingEnd="8dp"
            android:textColor="#333333"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_source_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="人民币（CNY） >"
            android:textColor="#757575"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="汇率"
            android:textColor="#333333"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/et_exchange_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="end"
            android:inputType="numberDecimal"
            android:paddingEnd="8dp"
            android:text="1.0"
            android:textColor="#2196F3"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_refresh_rate"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#2196F3" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="转入金额"
                android:textColor="#333333"
                android:textSize="@dimen/text_size_16" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="币种与转入账户一致"
                android:textColor="#9E9E9E"
                android:textSize="@dimen/text_size_10" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_target_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="end"
            android:inputType="numberDecimal"
            android:paddingEnd="8dp"
            android:text="0.00"
            android:textColor="#333333"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_target_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="波兰兹罗提（PLN） >"
            android:textColor="#757575"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_formula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="4dp"
        android:text="55.00 * 1.8"
        android:textColor="#9E9E9E"
        android:textSize="@dimen/text_size_12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="取消"
            android:textColor="#757575"
            android:textSize="@dimen/text_size_16" />

        <TextView
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:padding="12dp"
            android:text="确定"
            android:textColor="#2196F3"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
