<?xml version="1.0" encoding="utf-8"?>
<!-- 用户消息（右侧） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/chat_message_side_inset"
    android:paddingEnd="@dimen/chat_msg_spacing_horizontal"
    android:paddingTop="@dimen/chat_msg_spacing_vertical"
    android:paddingBottom="@dimen/chat_msg_spacing_vertical">

    <TextView
        android:id="@+id/tv_user_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/chat_time_chip_text"
        android:layout_marginBottom="@dimen/chat_time_margin_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|top">

        <CheckBox
            android:id="@+id/cb_user_select"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/chat_avatar_margin_end"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_user_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_bubble_user"
                android:paddingHorizontal="@dimen/chat_bubble_padding_h"
                android:paddingVertical="@dimen/chat_bubble_padding_v"
                android:textSize="15sp"
                android:textColor="@color/chat_user_bubble_text"
                android:lineSpacingExtra="4dp"
                android:scrollHorizontally="false"
                android:hyphenationFrequency="none"
                android:linksClickable="true"
                android:textIsSelectable="true"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/iv_user_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_chat_image_thumb"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/view_large_image"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_user_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_file_bubble"
                android:gravity="center_vertical"
                android:minWidth="168dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_user_file_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/chat_attach_file"
                    android:src="@drawable/ic_chat_file" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_user_file_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxWidth="220dp"
                        android:maxLines="1"
                        android:textColor="@color/chat_user_bubble_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_user_file_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:textColor="@color/chat_bill_detail_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_user_voice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_voice_bubble"
                android:gravity="center_vertical"
                android:minWidth="80dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_voice_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="1&quot;"
                    android:textColor="@color/chat_voice_bubble_text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/layout_voice_wave"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal" />

                <ImageView
                    android:id="@+id/iv_voice_play"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_voice_play_telegram"
                    app:tint="@color/chat_voice_bubble_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_voice_transcript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_voice_transcript"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_voice_transcript_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/to_text"
                        android:textColor="@color/chat_bill_detail_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_voice_transcript"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/chat_ai_bubble_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_voice_transcript_copy"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy_transcript"
                    android:padding="1dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/chat_bill_detail_text" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="@dimen/chat_avatar_size"
            android:layout_height="@dimen/chat_avatar_size"
            android:clickable="true"
            android:contentDescription="@string/user_avatar"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user_avatar_default" />
    </LinearLayout>
</LinearLayout>
