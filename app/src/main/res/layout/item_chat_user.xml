<?xml version="1.0" encoding="utf-8"?>
<!-- 用户消息气泡（右侧） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tv_user_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chat_time_chip"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#6F8099"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- 多选复选框（多选模式时显示在气泡左侧） -->
        <CheckBox
            android:id="@+id/cb_user_select"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="8dp"
            android:layout_weight="0"
            android:maxWidth="292dp">

        <!-- 文字气泡 -->
        <TextView
            android:id="@+id/tv_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="292dp"
            android:background="@drawable/bg_chat_bubble_user"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="2dp"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:hyphenationFrequency="full"
            android:visibility="visible" />

        <!-- 图片气泡 -->
        <ImageView
            android:id="@+id/iv_user_image"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_chat_bubble_user"
            android:padding="4dp"
            android:visibility="gone" />

        <!-- 语音标签 -->
        <LinearLayout
            android:id="@+id/layout_user_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chat_voice_bubble"
            android:minWidth="118dp"
            android:paddingStart="9dp"
            android:paddingTop="7dp"
            android:paddingEnd="9dp"
            android:paddingBottom="7dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chat_voice_play_chip">

                <ImageView
                    android:id="@+id/iv_voice_play"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_voice_play_telegram"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_voice_wave"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_voice_bar_1"
                    android:layout_width="3dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_chat_voice_wave_bar"
                    android:alpha="0.64" />

                <View
                    android:id="@+id/view_voice_bar_2"
                    android:layout_width="3dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_chat_voice_wave_bar"
                    android:alpha="0.84" />

                <View
                    android:id="@+id/view_voice_bar_3"
                    android:layout_width="3dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_chat_voice_wave_bar"
                    android:alpha="0.74" />

                <View
                    android:id="@+id/view_voice_bar_4"
                    android:layout_width="3dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_chat_voice_wave_bar"
                    android:alpha="0.92" />

                <View
                    android:id="@+id/view_voice_bar_5"
                    android:layout_width="3dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_chat_voice_wave_bar"
                    android:alpha="0.72" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_voice_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1''"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F7FAFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_voice_transcript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chat_voice_transcript"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_voice_transcript_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="转文字"
                    android:textColor="#71819D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_voice_transcript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxWidth="232dp"
                    android:textColor="#2B3547"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_voice_transcript_copy"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="1dp"
                android:src="@drawable/ic_copy"
                app:tint="#6F7F99"
                android:contentDescription="复制转写文本" />
        </LinearLayout>
    </LinearLayout>

    <!-- 用户头像 -->
    <ImageView
        android:id="@+id/iv_user_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_user_avatar_default"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_soft"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="用户头像"
        android:layout_gravity="top" />
    </LinearLayout>

</LinearLayout>
