<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/layout_book_actions"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btn_book_edit"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_book_action_edit"
            android:clickable="true"
            android:contentDescription="edit"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_book_delete"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_book_action_delete"
            android:clickable="true"
            android:contentDescription="delete"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_foreground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_book_item_normal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tv_book_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#1C2E4A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_book_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="#1C2E4A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_book_set_default_inline"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_book_overview_entry_btn"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="设为默认"
            android:textColor="#4F75E2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/iv_book_selected"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_book_selected_badge"
            android:gravity="center"
            android:minWidth="42dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="当前"
            android:textColor="#3D67DA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
