<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_stats_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textSize="@dimen/dialog_title_size"
        android:textStyle="bold"
        android:textColor="@color/dialog_title"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="数据类型"
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/dialog_picker_normal_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_segmented_container"
            android:padding="2dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/tvTypeExpense"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="70dp"
                android:gravity="center"
                android:text="支出"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dialog_picker_normal_text"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvTypeBoth"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="70dp"
                android:gravity="center"
                android:text="收&amp;支"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dialog_picker_normal_text"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="40dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="日期范围"
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/dialog_picker_normal_text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_segmented_container"
            android:padding="2dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/tvRangeWeek"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="56dp"
                android:gravity="center"
                android:text="本周"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dialog_picker_normal_text"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvRange7d"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="56dp"
                android:gravity="center"
                android:text="7日"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dialog_picker_normal_text"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvRange15d"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="56dp"
                android:gravity="center"
                android:text="15日"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dialog_picker_normal_text"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvRangeHide"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="60dp"
                android:gravity="center"
                android:text="不显示"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/text_tertiary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnConfirmSettings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:gravity="center"
        android:text="确定"
        android:textSize="14sp"
        android:textColor="@color/dialog_button_primary_text"
        android:textStyle="bold"
        android:background="@drawable/bg_dialog_button_primary" />

</LinearLayout>
