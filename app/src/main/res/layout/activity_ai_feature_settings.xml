<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btn_back_ai_feature"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="#333333"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="AI 智能功能"
            android:textColor="#1A2744"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

<androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- 启用 AI 功能 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="10dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge_purple">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_profile_ai"
                                android:tint="#FFFFFF" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="启用 AI 功能"
                            android:textColor="#1A2744"
                            android:textSize="@dimen/text_size_16"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_show_ai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="0dp"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint" />
                    </LinearLayout>

                    <!-- AI 展开区 -->
                    <LinearLayout
                        android:id="@+id/layout_ai_main_entry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- AI 对话入口模式（位于多账单上方） -->
                        <LinearLayout
                            android:id="@+id/layout_ai_chat_entry_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="6dp"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp">

                            <LinearLayout
                                android:id="@+id/layout_open_ai_chat_page"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="6dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="AI 对话页面"
                                        android:textColor="#1F2A3D"
                                        android:textSize="@dimen/text_size_14"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="开启后，首页“+”直接进入 AI 对话记账。"
                                        android:textColor="#9AA4B2"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_ai_chat_mode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="6dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="记账页面增加 AI 入口"
                                        android:textColor="#1F2A3D"
                                        android:textSize="@dimen/text_size_14"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="在传统记账弹窗底部显示“切换到 AI 对话记账”按钮。"
                                        android:textColor="#9AA4B2"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_show_ai_chat_entry"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 多账单 + 规则开关组 -->
                        <LinearLayout
                            android:id="@+id/layout_multi_bill_settings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="6dp"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="开启多账单模式"
                                        android:textColor="#1F2A3D"
                                        android:textSize="@dimen/text_size_14"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="开启后，普通记账页可切换多笔识别；会话界面也会默认使用多账单提示词。"
                                        android:textColor="#9AA4B2"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_show_multi_bill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:layout_marginVertical="4dp"
                                android:background="#E7ECF4" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="不验证直接批量保存"
                                        android:textColor="#24324A"
                                        android:textSize="@dimen/text_size_13"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_multi_bill_not_sync_desc"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="识别结果将优先存入本地列表，方便后续核对或批量同步。"
                                        android:textColor="#9AA4B2"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_multi_bill_not_sync"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:layout_marginVertical="4dp"
                                android:background="#E7ECF4" />

                            <!-- 极简记账 -->
                            <LinearLayout
                                android:id="@+id/layout_multi_bill_fast_mode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="极简记账"
                                        android:textColor="#24324A"
                                        android:textSize="@dimen/text_size_13"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="开启后多账单识别速度更快，但分类准确率依赖本地规则，不确定时会留空。"
                                        android:textColor="#9AA4B2"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_multi_bill_fast_mode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:layout_marginVertical="4dp"
                                android:background="#E7ECF4" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="显示表单账本入口"
                                    android:textColor="#1F2A3D"
                                    android:textSize="@dimen/text_size_14"
                                    android:textStyle="bold" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_show_book_entry"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 动态提示词 + 本地规则 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="6dp"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="动态提示词纠错"
                                    android:textColor="#1F2A3D"
                                    android:textSize="@dimen/text_size_14"
                                    android:textStyle="bold" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_ai_prompt_correction"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:layout_marginVertical="4dp"
                                android:background="#E7ECF4" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="本地规则强覆盖"
                                    android:textColor="#1F2A3D"
                                    android:textSize="@dimen/text_size_14"
                                    android:textStyle="bold" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_local_rule_override"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 语音识别开关行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="语音记账"
                                    android:textColor="#1F2A3D"
                                    android:textSize="@dimen/text_size_15"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="开启后可通过语音识别快速生成账单"
                                    android:textColor="#9AA4B2"
                                    android:textSize="@dimen/text_size_11" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_show_voice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@color/switch_thumb_tint"
                                app:trackTint="@color/switch_track_tint" />
                        </LinearLayout>

                        <!-- 语音引擎 + 模型（按需展开） -->
                        <LinearLayout
                            android:id="@+id/layout_asr_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="4dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="6dp"
                                android:text="识别引擎"
                                android:textColor="#4E5A6A"
                                android:textSize="@dimen/text_size_14"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_asr_mode"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_spinner_rounded"
                                android:entries="@array/asr_modes" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_asr_model_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="8dp"
                            android:baselineAligned="false"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="6dp"
                                android:text="模型信息"
                                android:textColor="#4E5A6A"
                                android:textSize="@dimen/text_size_14"
                                android:textStyle="bold" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_delete_offline_model"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#D9E0EA"
                                app:strokeWidth="1dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="7dp"
                                    android:foreground="?attr/selectableItemBackground">

                                    <TextView
                                        android:id="@+id/tv_asr_model_desc"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:text="模型状态"
                                        android:textColor="#5F6B7A"
                                        android:textSize="@dimen/text_size_13"
                                        android:textStyle="bold" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- 图片记账开关行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="图片记账"
                                    android:textColor="#1F2A3D"
                                    android:textSize="@dimen/text_size_15"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="开启后可从小票或截图中识别账单信息"
                                    android:textColor="#9AA4B2"
                                    android:textSize="@dimen/text_size_11" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_show_ai_image"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@color/switch_thumb_tint"
                                app:trackTint="@color/switch_track_tint" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginBottom="6dp"
                            android:background="#E7ECF4" />

                        <!-- OCR 引擎 + 语言（按需展开） -->
                        <LinearLayout
                            android:id="@+id/layout_ocr_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="4dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="6dp"
                                android:text="识别引擎"
                                android:textColor="#4E5A6A"
                                android:textSize="@dimen/text_size_14"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_ocr_mode"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_spinner_rounded"
                                android:entries="@array/ocr_modes" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_receipt_lang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="6dp"
                                android:text="小票语言"
                                android:textColor="#4E5A6A"
                                android:textSize="@dimen/text_size_14"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_receipt_lang"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_spinner_rounded"
                                android:entries="@array/receipt_lang_modes" />
                        </LinearLayout>

                        <!-- OCR 调试 + 按钮 -->
                        <LinearLayout
                            android:id="@+id/layout_ocr_debug_panel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inset_panel"
                            android:layout_marginBottom="6dp"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="保存 OCR 原文"
                                        android:textColor="#1F2A3D"
                                        android:textSize="@dimen/text_size_14"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="用于排查识别问题与优化提示词"
                                        android:textColor="#9AA4B2"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switch_save_ocr_debug"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:thumbTint="@color/switch_thumb_tint"
                                    app:trackTint="@color/switch_track_tint" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_ocr_debug"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_gravity="end"
                                android:layout_marginTop="4dp"
                                android:minHeight="0dp"
                                android:text="查看 →"
                                android:textColor="#5C6BC0"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginVertical="6dp"
                            android:background="#F0F2F5" />

                        <!-- 底部操作按钮行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_manage_ai_rules"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="记账习惯"
                                android:textColor="#4E5A6A"
                                android:textSize="@dimen/text_size_14"
                                app:backgroundTint="#FFFFFF"
                                app:strokeColor="#DCE2EA"
                                app:cornerRadius="12dp"
                                app:rippleColor="#205C6BC0" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_ai_detailed_config"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="AI 详细配置"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_14"
                                android:textStyle="bold"
                                app:backgroundTint="#5C6BC0"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

