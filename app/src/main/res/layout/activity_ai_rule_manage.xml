<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rule_page_root"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rule_page_section"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="记账习惯"
            android:textColor="#24344A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="把常见口语和记账结果绑定起来，之后 AI 命中关键词时就会更懂你的记账方式。"
            android:textColor="#8A98AD"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_rule_search"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_model_search_field"
            android:hint="搜索关键词、分类、账户或类型"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#25344A"
            android:textColorHint="#92A1B5"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_rule_multi_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rule_page_section"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_rule_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已选择 0 条"
            android:textColor="#2A3A53"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_rule_select_all"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_rule_subtle_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="全选"
            android:textColor="#4665A9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_rule_cancel_multi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_action_item"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="取消"
            android:textColor="#72819A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_rule_delete_multi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_action_item_danger"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="删除"
            android:textColor="#B3261E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_rules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_rule"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="添加记账习惯"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#4B6DB8"
        app:cornerRadius="16dp" />

</LinearLayout>
