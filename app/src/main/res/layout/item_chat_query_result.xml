<?xml version="1.0" encoding="utf-8"?>
<!-- 查询结果卡片 - 聊天内展示查询结果 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <!-- 时间戳 -->
    <TextView
        android:id="@+id/tv_query_result_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/chat_time_chip_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 气泡行：头像 + 卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- AI 头像 -->
        <ImageView
            android:id="@+id/iv_query_result_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:scaleType="centerCrop" />

        <!-- 卡片内容 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_bubble_ai"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 标题 -->
            <TextView
                android:id="@+id/tv_query_result_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/query_result_title"
                android:textColor="#1A1A1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginVertical="8dp"
                android:background="#E1E8F0" />

            <!-- 查询条件摘要 -->
            <TextView
                android:id="@+id/tv_query_result_conditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8A97A8"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginVertical="8dp"
                android:background="#E1E8F0" />

            <!-- 结果金额 -->
            <TextView
                android:id="@+id/tv_query_result_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 代表账单预览 -->
            <LinearLayout
                android:id="@+id/container_bill_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:background="#E1E8F0" />

            <!-- 操作按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 查看明细 -->
                <TextView
                    android:id="@+id/btn_query_view_details"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#F0F5FA"
                    android:gravity="center"
                    android:text="@string/query_btn_view_details"
                    android:textColor="#2196F3"
                    android:textSize="12sp" />

                <!-- 改条件 -->
                <TextView
                    android:id="@+id/btn_query_edit_conditions"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="#F0F5FA"
                    android:gravity="center"
                    android:text="@string/query_btn_edit_conditions"
                    android:textColor="#8A97A8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
