<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/layout_mode_switch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="显示方式"
            android:textColor="@color/dialog_title"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/dialog_title_size"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tv_mode_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="按月"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/dialog_title_size" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_tertiary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dialog_divider" />

    <LinearLayout
        android:id="@+id/panel_month"
        android:layout_width="wrap_content"
        android:layout_height="268dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_year_list"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingHorizontal="4dp"
            android:scrollbars="none" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dialog_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_month_grid"
            android:layout_width="152dp"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingHorizontal="4dp"
            android:scrollbars="none" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_year_grid"
        android:layout_width="match_parent"
        android:layout_height="292dp"
        android:overScrollMode="never"
        android:padding="6dp"
        android:scrollbars="none"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="在首页加载【当前账本】下所有时间范围内的数据"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_all_confirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dialog_button_primary"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/dialog_button_primary_text"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
