<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <View
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_segmented_container" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btn_close_filter_sheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_segmented_container"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#23324A" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自定义筛选"
                android:textColor="#142033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="调整统计的时间范围与账本"
                android:textColor="#7B8698"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_confirm_filter_sheet"
            android:layout_width="84dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_stats_filter_confirm"
            android:gravity="center"
            android:text="应用"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rule_page_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快捷范围"
                    android:textColor="#152238"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="快速切到常用的统计区间"
                    android:textColor="#7B8698"
                    android:textSize="12sp" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:isScrollContainer="false"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="10dp"
                    app:singleLine="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_today"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="&#20170;&#22825;"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_yesterday"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="&#26152;&#22825;"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_this_week"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="&#26412;&#21608;"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_last_week"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="&#19978;&#21608;"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_this_month"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="本月"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_last_month"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="上月"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_this_year"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="今年"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_last_year"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="去年"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filter_all"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="全部"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:chipBackgroundColor="@color/chip_bg_selector"
                        app:chipCornerRadius="20dp"
                        app:checkedIconVisible="false" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rule_page_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自定义日期"
                    android:textColor="#152238"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="选择开始和结束日期，精确筛选统计范围"
                    android:textColor="#7B8698"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tv_filter_start_date"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_container"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开始"
                            android:textColor="#7B8698"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_filter_start_date_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="选择日期"
                            android:textColor="#22324A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:text="至"
                        android:textColor="#95A0AF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/tv_filter_end_date"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_container"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="结束"
                            android:textColor="#7B8698"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_filter_end_date_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="选择日期"
                            android:textColor="#22324A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rule_page_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账本范围"
                    android:textColor="#152238"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="按账本筛选统计结果"
                    android:textColor="#7B8698"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_filter_book_selector"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_segmented_container"
                    android:drawableEnd="@android:drawable/arrow_down_float"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:text="全部账本"
                    android:textColor="#22324A"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_reset_filter_sheet"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_outline_blue"
                android:gravity="center"
                android:text="重置筛选"
                android:textColor="#2C74FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
