<?xml version="1.0" encoding="utf-8"?>
<!-- 查询草稿卡片 - 聊天内展示可编辑的查询条件 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <!-- 时间戳 -->
    <TextView
        android:id="@+id/tv_query_draft_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chat_time_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:textColor="#8A97A8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 气泡行：头像 + 卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- AI 头像 -->
        <ImageView
            android:id="@+id/iv_query_draft_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:scaleType="centerCrop" />

        <!-- 卡片内容 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_bubble_ai"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 标题 -->
            <TextView
                android:id="@+id/tv_query_draft_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/query_draft_title"
                android:textColor="#2196F3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginVertical="8dp"
                android:background="#EDF2F7" />

            <!-- 关键词行 -->
            <LinearLayout
                android:id="@+id/row_keyword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/query_keyword"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="："
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_query_keyword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 分类行 -->
            <LinearLayout
                android:id="@+id/row_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/query_category"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="："
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_query_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 资产行 -->
            <LinearLayout
                android:id="@+id/row_asset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/query_asset"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="："
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_query_asset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 时间行 -->
            <LinearLayout
                android:id="@+id/row_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/query_time_range"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="："
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_query_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 类型行 -->
            <LinearLayout
                android:id="@+id/row_bill_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/query_bill_type"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="："
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_query_bill_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 账本行 -->
            <LinearLayout
                android:id="@+id/row_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/query_book_scope"
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="："
                    android:textColor="#8A97A8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_query_book"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:background="#EDF2F7" />

            <!-- 操作按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 统计金额 -->
                <TextView
                    android:id="@+id/btn_query_stats"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dialog_button_primary"
                    android:gravity="center"
                    android:text="@string/query_btn_stats"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <!-- 搜索账单 -->
                <TextView
                    android:id="@+id/btn_query_search"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dialog_button_cancel"
                    android:gravity="center"
                    android:text="@string/query_btn_search"
                    android:textColor="#2196F3"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <!-- 取消 -->
                <TextView
                    android:id="@+id/btn_query_cancel"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dialog_button_cancel"
                    android:gravity="center"
                    android:text="@string/query_btn_cancel"
                    android:textColor="#8A97A8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 提示文字 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/query_hint_correction"
                android:textColor="#B0B8C4"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
