<?xml version="1.0" encoding="utf-8"?>
<!-- AI 账单卡片（聊天流样式） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bill_item_chat"
        android:padding="12dp">

    <!-- 图标 + 分类详情 + 金额 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/layout_chat_bill_icon_container"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_chat_bill_icon_container"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/iv_chat_bill_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="centerInside"
                    android:tint="#444444" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_chat_bill_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#25344C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_chat_bill_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#7A8598"
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_chat_bill_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="76dp"
                    android:background="@drawable/bg_chat_bill_amount_tag"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:gravity="center"
                    android:textSize="17sp"
                    android:letterSpacing="0.01"
                    android:textStyle="bold"
                    android:textColor="#D32F2F" />

                <EditText
                    android:id="@+id/et_chat_bill_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="76dp"
                    android:background="@drawable/bg_chat_bill_amount_tag"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textSize="17sp"
                    android:letterSpacing="0.01"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 时间 + 已编辑标签 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_chat_bill_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8C97AA"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_chat_bill_edited_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="已编辑"
                android:textColor="#FF9800"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:layout_marginTop="9dp">

        <TextView
            android:id="@+id/btn_chat_bill_edit_category"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="修改分类"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1F5FC8"
            android:background="@drawable/bg_chat_bill_action_primary"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_chat_bill_delete"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="删除"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#C13E4A"
            android:background="@drawable/bg_chat_bill_action_danger"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>