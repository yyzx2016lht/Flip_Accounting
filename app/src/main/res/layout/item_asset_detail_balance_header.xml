<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tv_header_balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="账户余额"
        android:textColor="#999999"
        android:textSize="@dimen/text_size_14" />

    <TextView
        android:id="@+id/tv_header_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="¥0.00"
        android:textColor="#333333"
        android:textSize="@dimen/text_size_28"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_header_remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8E98A3"
        android:textSize="@dimen/text_size_12"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_header_archive_action"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_book_overview_entry_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="112dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="收纳这个资产"
        android:textColor="#4F75E2"
        android:textSize="@dimen/text_size_12"
        android:textStyle="bold" />

</LinearLayout>
