<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">
        <ImageView
            android:id="@+id/toolbar"
            android:layout_width="@dimen/icon_size_40"
            android:layout_height="@dimen/icon_size_40"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:layout_centerVertical="true"
            app:tint="#333333" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="翻转灵敏度调节"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="#333333" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 进阶模式开关卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAdvancedMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="进阶自定义模式"
                        android:textSize="@dimen/text_size_15"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="开启后可手动精确修改重力阈值和耗时参数"
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#999999"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 标准模式：SeekBar 卡片 -->
            <LinearLayout
                android:id="@+id/layoutStandardMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="翻转检测灵敏度"
                            android:textSize="@dimen/text_size_14"
                            android:textColor="#444444"
                            android:textStyle="bold"/>

                        <!-- 当前值指示 -->
                        <TextView
                            android:id="@+id/tvCurrentValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"
                            android:text="当前设定：标准 (50)"
                            android:textColor="#2196F3"
                            android:textSize="@dimen/text_size_15"
                            android:textStyle="bold"
                            android:background="#EFF6FF"
                            android:paddingVertical="8dp"
                            android:paddingHorizontal="12dp"/>

                        <!-- SeekBar + 标签 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="14dp">
                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="wrap_content"
                                android:text="容易"
                                android:textSize="@dimen/text_size_11"
                                android:textColor="#999999"
                                android:gravity="center"/>
                            <SeekBar
                                android:id="@+id/seekBarSensitivity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:max="100"
                                android:progress="50"/>
                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="wrap_content"
                                android:text="严格"
                                android:textSize="@dimen/text_size_11"
                                android:textColor="#999999"
                                android:gravity="center"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- 进阶模式：自定义输入卡片 -->
            <LinearLayout
                android:id="@+id/layoutAdvancedInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自定义参数"
                        android:textSize="@dimen/text_size_14"
                        android:textColor="#444444"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp"/>                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="重力阈值 (g)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            app:helperText="建议范围 5.0 – 9.5">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCustomG"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:text="7.25"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="最大翻转允许耗时 (ms)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            app:helperText="建议范围 200 – 1000">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCustomTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="550"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveCustom"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:text="保存自定义参数"
                            android:textSize="@dimen/text_size_15"
                            app:cornerRadius="24dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- 参数详解卡片 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="参数详解"
                android:textSize="@dimen/text_size_13"
                android:textColor="#888888"
                android:textStyle="bold"
                android:paddingHorizontal="4dp"
                android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 重力阈值 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡"
                            android:textSize="@dimen/text_size_20"
                            android:layout_marginEnd="8dp"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="10"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvParamG"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="重力阈值：7.25g"
                                android:textSize="@dimen/text_size_14"
                                android:textColor="#333333"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="手机扣向桌面的平整度要求，数值越大要求越平。"
                                android:textSize="@dimen/text_size_12"
                                android:textColor="#999999"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginVertical="12dp"/>

                    <!-- 耗时 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⏱"
                            android:textSize="@dimen/text_size_20"
                            android:layout_marginEnd="8dp"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="10"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvParamTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="最大耗时：550ms"
                                android:textSize="@dimen/text_size_14"
                                android:textColor="#333333"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="从背面翻转到正面的最大允许时间，越小要求翻转越快。"
                                android:textSize="@dimen/text_size_12"
                                android:textColor="#999999"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部恢复默认按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:background="#FFFFFF"
        android:elevation="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDefault"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="恢复默认设置"
            android:textSize="@dimen/text_size_15"
            android:textColor="#2196F3"
            app:cornerRadius="24dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="#2196F3"
            app:strokeWidth="1.5dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    </LinearLayout>

</LinearLayout>