<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_card"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/import_onboarding_title"
            android:textColor="@color/settings_item_title"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_onboarding_desc"
                android:textColor="#666666"
                android:textSize="@dimen/text_size_14"
                android:layout_marginBottom="24dp" />

            <!-- 随手记 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_source_suishouji"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/import_source_suishouji"
                android:textColor="#4E5A6A"
                android:textSize="@dimen/text_size_14"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#DCE2EA" />

            <!-- 钱迹 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_source_qianji"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/import_source_qianji"
                android:textColor="#4E5A6A"
                android:textSize="@dimen/text_size_14"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#DCE2EA" />

            <!-- 其他 CSV -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_source_csv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/import_source_csv"
                android:textColor="#4E5A6A"
                android:textSize="@dimen/text_size_14"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                app:strokeColor="#DCE2EA" />

            <!-- 本应用备份 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_source_backup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/import_source_backup"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                app:backgroundTint="#5C6BC0"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
