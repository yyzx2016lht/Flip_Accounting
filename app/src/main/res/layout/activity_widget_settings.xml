<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_page_bg"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/settings_card_bg"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">
        <ImageView
            android:id="@+id/btn_widget_settings_back"
            android:layout_width="@dimen/icon_size_40"
            android:layout_height="@dimen/icon_size_40"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:layout_centerVertical="true"
            app:tint="@color/settings_item_title" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="桌面小组件"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/settings_item_title" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="长按桌面空白处 → 添加小组件 → 搜索本应用即可添加。已添加到桌面的小组件会显示在下面，可以直接编辑显示内容。"
                android:textColor="@color/settings_item_subtitle"
                android:textSize="@dimen/text_size_11"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tv_widget_settings_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="暂无已添加到桌面的小组件"
                android:textColor="@color/settings_item_subtitle"
                android:textSize="@dimen/text_size_13"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_widget_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
