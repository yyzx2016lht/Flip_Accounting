<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingEnd="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/dialog_content_padding"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_asset_picker_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择资产"
            android:textSize="@dimen/dialog_title_size"
            android:textStyle="bold"
            android:textColor="@color/dialog_title"/>

        <TextView
            android:id="@+id/tv_asset_picker_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按拖动排序"
            android:textSize="@dimen/dialog_subtitle_size"
            android:textColor="@color/dialog_subtitle"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_assets"
        android:layout_width="match_parent"
        android:layout_height="@dimen/overlay_picker_grid_visible_height"
        android:clipToPadding="false"
        android:overScrollMode="never"/>

    <Button
        android:id="@+id/btn_confirm_asset"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_button_primary"
        android:text="确 认"
        android:textColor="@color/dialog_button_primary_text"
        android:textStyle="bold"
        android:textSize="15sp"
        android:stateListAnimator="@null"/>
</LinearLayout>
