<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_book_item_normal"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_delete_option_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2F3748"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_delete_option_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#8A93A6"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_delete_option_risk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_delete_risk_tag"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="高风险"
        android:textColor="#C13A2A"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
