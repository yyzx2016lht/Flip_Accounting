<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择要恢复的模块"
            android:textColor="#1A2744"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="恢复时会只覆盖你勾选的内容，其它模块不会动。"
            android:textColor="#7C8798"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_backup_warning"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="注意"
                android:textColor="#CE5330"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="恢复对应模块会覆盖当前同类数据，请只勾选你确认要恢复的部分。"
                android:textColor="#A96557"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_restore_core"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_backup_group"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="核心账本数据"
                android:textColor="#2D3C57"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="资产数据"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分类设置"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_bills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="账单记录"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="记账习惯"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_banners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="账本封面图"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_restore_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_backup_group"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="聊天与对话"
                android:textColor="#2D3C57"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_chat_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="聊天记录"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_chat_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="聊天资源"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_restore_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_backup_group"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="偏好与界面设置"
                android:textColor="#2D3C57"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_basic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="基础设置"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="资产与汇率"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_cloud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="云端配置"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="入口与卡片"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_bills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="账单显示"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_multibill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="多账本与 OCR"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_ai_core"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 核心配置"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_ai_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 提示词"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_ai_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 对话设置"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="账本偏好"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_advanced_runtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="系统与调试"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />


            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="基础设置（旧版整组）"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="显示设置（旧版整组）"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_advanced_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="高级设置（旧版整组）"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
