<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设定入账时间"
        android:gravity="center"
        android:textColor="#333333"
        android:textSize="@dimen/text_size_17"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_box"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <NumberPicker android:id="@+id/np_year" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1.2" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="年" android:textSize="@dimen/text_size_12" android:textColor="#5C6BC0" android:textStyle="bold"/>

        <NumberPicker android:id="@+id/np_month" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="月" android:textSize="@dimen/text_size_12" android:textColor="#5C6BC0" android:textStyle="bold"/>

        <NumberPicker android:id="@+id/np_day" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日" android:textSize="@dimen/text_size_12" android:textColor="#5C6BC0" android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_gravity="center"
        android:layout_marginVertical="14dp"
        android:background="#E4E9F2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_box"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp">

        <NumberPicker android:id="@+id/np_hour" android:layout_width="50dp" android:layout_height="120dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="时" android:textSize="@dimen/text_size_14" android:textColor="#5C6BC0" android:textStyle="bold" android:layout_marginEnd="12dp"/>

        <NumberPicker android:id="@+id/np_minute" android:layout_width="50dp" android:layout_height="120dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分" android:textSize="@dimen/text_size_14" android:textColor="#5C6BC0" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_time"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="取消"
            android:textSize="@dimen/text_size_15"
            android:textColor="#7A8799"
            app:cornerRadius="23dp"
            app:strokeColor="#D9E2F2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_time"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.8"
            android:layout_marginStart="10dp"
            android:backgroundTint="#5C6BC0"
            android:text="确定"
            android:textSize="@dimen/text_size_15"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="23dp"
            app:elevation="0dp" />
    </LinearLayout>

</LinearLayout>
