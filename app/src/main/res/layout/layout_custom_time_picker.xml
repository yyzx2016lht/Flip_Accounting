<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_entry_time"
        android:gravity="center"
        android:textColor="@color/dialog_title"
        android:textSize="@dimen/dialog_title_size"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_box"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <NumberPicker android:id="@+id/np_year" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1.2" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/year_label" android:textSize="@dimen/text_size_12" android:textColor="@color/brand_primary" android:textStyle="bold"/>

        <NumberPicker android:id="@+id/np_month" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/month_label" android:textSize="@dimen/text_size_12" android:textColor="@color/brand_primary" android:textStyle="bold"/>

        <NumberPicker android:id="@+id/np_day" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/day_label" android:textSize="@dimen/text_size_12" android:textColor="@color/brand_primary" android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_gravity="center"
        android:layout_marginVertical="14dp"
        android:background="@color/dialog_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_box"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp">

        <NumberPicker android:id="@+id/np_hour" android:layout_width="50dp" android:layout_height="120dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hour_label" android:textSize="@dimen/text_size_14" android:textColor="@color/brand_primary" android:textStyle="bold" android:layout_marginEnd="12dp"/>

        <NumberPicker android:id="@+id/np_minute" android:layout_width="50dp" android:layout_height="120dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/minute_label" android:textSize="@dimen/text_size_14" android:textColor="@color/brand_primary" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel_time"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button_cancel"
            android:gravity="center"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:textColor="@color/dialog_button_cancel_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_confirm_time"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_weight="1.8"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dialog_button_primary"
            android:gravity="center"
            android:text="@string/confirm_action"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_button_primary_text" />
    </LinearLayout>

</LinearLayout>
