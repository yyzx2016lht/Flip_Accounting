<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <com.taostudio.tapaccounting.ui.widget.SecondaryPageHeaderView
        android:id="@+id/secondary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="存储清理" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="#DEE6F2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_result"
                        android:textColor="@color/settings_item_title"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_cleanup_total_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="可清理总计：0 个文件 · 0 B"
                        android:textColor="#5A6B84"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cleanup_refresh"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/rescan"
                        android:textColor="#44556E"
                        app:backgroundTint="#EAF0FB"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="#DEE6F2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:text="@string/select_cleanup_content"
                    android:textColor="@color/settings_item_title"
                    android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_cleanup_older_30"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/cleanup_30day_hint"
                        android:textColor="#5A6B84"
                        android:textSize="12sp"
                        app:buttonTint="#5C80EA" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_cleanup_voice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/chat_voice_files"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:buttonTint="#5C80EA" />

                    <TextView
                        android:id="@+id/tv_cleanup_voice_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="聊天语音：0 个 · 0 B"
                        android:textColor="#7A879A"
                        android:textSize="12sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_cleanup_images"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/chat_image_files"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:buttonTint="#5C80EA" />

                    <TextView
                        android:id="@+id/tv_cleanup_images_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="聊天图片：0 个 · 0 B"
                        android:textColor="#7A879A"
                        android:textSize="12sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_cleanup_chat_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="false"
                        android:text="@string/chat_avatar_files"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:buttonTint="#5C80EA" />

                    <TextView
                        android:id="@+id/tv_cleanup_chat_avatar_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="聊天头像：0 个 · 0 B"
                        android:textColor="#7A879A"
                        android:textSize="12sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_cleanup_book_cover_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="false"
                        android:text="@string/book_cover_bg"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:buttonTint="#5C80EA" />

                    <TextView
                        android:id="@+id/tv_cleanup_book_cover_bg_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="账本封面与背景：0 个 · 0 B"
                        android:textColor="#7A879A"
                        android:textSize="12sp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_cleanup_temp_cache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/temp_cache_files"
                        android:textColor="#23324A"
                        android:textSize="14sp"
                        app:buttonTint="#5C80EA" />

                    <TextView
                        android:id="@+id/tv_cleanup_temp_cache_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="临时与缓存：0 个 · 0 B"
                        android:textColor="#7A879A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cleanup_safe_hint"
                        android:textColor="#5A6B84"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cleanup_preview"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/preview_files"
                        android:textColor="#44556E"
                        app:backgroundTint="#EAF0FB"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cleanup_do"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:elevation="0dp"
                        android:maxLines="1"
                        android:stateListAnimator="@null"
                        android:text="@string/cleanup_selected"
                        app:backgroundTint="#D1495B"
                        app:cornerRadius="10dp"
                        app:icon="@android:drawable/ic_menu_delete"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_history_bills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="#DEE6F2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trash"
                            android:textColor="@color/settings_item_title"
                            android:textSize="@dimen/text_size_16"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_history_bills_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/view_deleted_bills"
                            android:textColor="#7A879A"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#999999" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

