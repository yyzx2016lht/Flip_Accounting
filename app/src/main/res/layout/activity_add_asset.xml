<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_size_32"
            android:layout_height="@dimen/icon_size_32"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="#333333"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="添加账户"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="#333333"/>
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="保存"
            android:textColor="#2196F3"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:padding="8dp"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Basic Info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- Type Selection -->
                    <LinearLayout
                        android:id="@+id/layout_select_type"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="账户类型"
                            android:textColor="#333333"
                            android:textSize="@dimen/text_size_16"/>
                        <ImageView
                            android:id="@+id/iv_type_icon"
                            android:layout_width="@dimen/icon_size_24"
                            android:layout_height="@dimen/icon_size_24"
                            android:layout_marginEnd="8dp"
                            android:src="@android:drawable/ic_menu_gallery"/>
                        <TextView
                            android:id="@+id/tv_type_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="请选择"
                            android:textColor="#999999"
                            android:textSize="@dimen/text_size_16"
                            android:layout_marginEnd="4dp"/>
                        <ImageView
                            android:layout_width="@dimen/icon_size_16"
                            android:layout_height="@dimen/icon_size_16"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="#CCCCCC"/>
                    </LinearLayout>

                    <!-- Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="账户名称"
                            android:textColor="#333333"
                            android:textSize="@dimen/text_size_16"/>
                        <EditText
                            android:id="@+id/et_name"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="请输入名称"
                            android:textColor="#2196F3"
                            android:gravity="end|center_vertical"
                            android:textSize="@dimen/text_size_16"
                            android:singleLine="true"/>
                    </LinearLayout>

                    <!-- Balance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="账户余额"
                            android:textColor="#333333"
                            android:textSize="@dimen/text_size_16"/>
                        <EditText
                            android:id="@+id/et_balance"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="0.00"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="#999999"
                            android:gravity="end|center_vertical"
                            android:textSize="@dimen/text_size_16"/>
                    </LinearLayout>

                    <!-- Asset Category -->
                    <LinearLayout
                        android:id="@+id/layout_select_asset_category"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="资产类别"
                            android:textColor="#333333"
                            android:textSize="@dimen/text_size_16"/>
                        <TextView
                            android:id="@+id/tv_asset_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="资金"
                            android:textColor="#2196F3"
                            android:textSize="@dimen/text_size_16"
                            android:layout_marginEnd="4dp"/>
                        <ImageView
                            android:layout_width="@dimen/icon_size_16"
                            android:layout_height="@dimen/icon_size_16"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="#CCCCCC"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Advanced Settings -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- Currency -->
                    <LinearLayout
                        android:id="@+id/layout_select_currency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="币种"
                                android:textColor="#333333"
                                android:textSize="@dimen/text_size_16"/>
                            <TextView
                                android:id="@+id/tv_currency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@id/iv_arrow_cur"
                                android:text="人民币（CNY）"
                                android:textColor="#2196F3"
                                android:textSize="@dimen/text_size_16"
                                android:layout_marginEnd="4dp"/>
                            <ImageView
                                android:id="@+id/iv_arrow_cur"
                                android:layout_width="@dimen/icon_size_16"
                                android:layout_height="@dimen/icon_size_16"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#CCCCCC"/>
                        </RelativeLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="此资产下的账单，将会以此币种为单位来记录"
                            android:textColor="#999999"
                            android:textSize="@dimen/text_size_12"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Include in Net Asset -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="计入总资产"
                                android:textColor="#333333"
                                android:textSize="@dimen/text_size_16"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/sw_include_net"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:checked="true"/>
                        </RelativeLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="如果开启，则此账户的金额将会算入总资产"
                            android:textColor="#999999"
                            android:textSize="@dimen/text_size_12"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Remark -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <EditText
                    android:id="@+id/et_remark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:background="@null"
                    android:hint="备注"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textSize="@dimen/text_size_16"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:maxLines="1"
                    android:gravity="top"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Type Picker Overlay (Pinned to top, but below Toolbar) -->
    <LinearLayout
        android:id="@+id/layout_type_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="#F7F8FA"
        android:padding="16dp"
        android:visibility="gone">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <EditText
                android:id="@+id/et_search_type"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:hint="搜索账户类型..."
                android:paddingHorizontal="16dp"
                android:background="@android:drawable/edit_text"
                android:textSize="@dimen/text_size_14"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_icon_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:padding="8dp"/>
    </LinearLayout>

</RelativeLayout>
