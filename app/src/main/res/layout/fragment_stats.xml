<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stats_page_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/stats_top_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_book_switch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="切换账本"
                    android:padding="7dp"
                    android:src="@drawable/ic_switch_book"
                    app:tint="#1F2937" />

                <ImageView
                    android:id="@+id/btn_prev_date"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_toStartOf="@id/layout_date_selector"
                    android:layout_marginEnd="6dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="9dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#4B5563" />

                <LinearLayout
                    android:id="@+id/layout_date_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_stats_date_capsule"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tv_date_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026-03"
                        android:textColor="#111827"
                        android:textSize="@dimen/text_size_15"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#6B7280" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_next_date"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_toEndOf="@id/layout_date_selector"
                    android:layout_marginStart="6dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="9dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#4B5563" />

                <ImageView
                    android:id="@+id/btn_filter"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="7dp"
                    android:src="@drawable/ic_shaixuan"
                    app:tint="#1F2937" />
            </RelativeLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/layout_mode_switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="112dp"
        android:layout_marginHorizontal="12dp"
        android:background="#F5F7FA"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_mode_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="月视图"
                android:textColor="#111827"
                android:textSize="@dimen/text_size_13"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_mode_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="年视图"
                android:textColor="#6B7280"
                android:textSize="@dimen/text_size_13"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/indicator_mode_month"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#111827" />

            <View
                android:layout_width="14dp"
                android:layout_height="2dp" />

            <View
                android:id="@+id/indicator_mode_year"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_stats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <include layout="@layout/card_stats_overview" />

            <LinearLayout
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="没有可统计的数据"
                    android:textColor="#9CA3AF"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/card_stats_category_report" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
