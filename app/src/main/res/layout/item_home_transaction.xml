<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_bill_group_single"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <CheckBox
        android:id="@+id/cb_bill_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_icon_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_home_transaction_icon"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_bill_category_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:scaleType="fitCenter"
            app:tint="#444444" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_bill_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#283548"
            android:textSize="@dimen/text_size_15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_bill_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Account | Remark"
            android:textColor="#7B8BA3"
            android:textSize="@dimen/text_size_12" />

        <TextView
            android:id="@+id/tv_bill_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2026-02-15 14:30"
            android:textColor="#A2AEC0"
            android:textSize="@dimen/text_size_11"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_bill_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-50.00"
        android:textColor="#C62828"
        android:textSize="@dimen/text_size_17"
        android:textStyle="bold" />

</LinearLayout>
