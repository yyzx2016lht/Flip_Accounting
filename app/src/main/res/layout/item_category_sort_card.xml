<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_category_sort_card"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:minHeight="82dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="14dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/layout_sort_icon_wrap"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_circle_soft"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_sort_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_sort_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#232323"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sort_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_sort_drag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="⋮⋮"
        android:textColor="#B0B0B0"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/iv_sort_arrow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="#B8B8B8" />

</LinearLayout>
