<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recurring_merchant_hint"
            android:textColor="#374151"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_recurring_merchant"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="@string/recurring_merchant_example"
            android:inputType="text"
            android:textColor="#111827"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/recurring_amount_hint"
            android:textColor="#374151"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_recurring_amount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="50"
            android:inputType="numberDecimal"
            android:textColor="#111827"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/recurring_tolerance_hint"
            android:textColor="#374151"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_recurring_tolerance"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="5"
            android:inputType="numberDecimal"
            android:textColor="#111827"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/recurring_frequency_hint"
            android:textColor="#374151"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_recurring_frequency"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/recurring_day_hint"
            android:textColor="#374151"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_recurring_day"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:hint="27"
            android:inputType="number"
            android:textColor="#111827"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/budget_category_pick"
            android:textColor="#374151"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_recurring_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/recurring_account_hint"
            android:textColor="#374151"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_recurring_account"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
