<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_content_padding"
    android:paddingTop="@dimen/dialog_content_padding"
    android:paddingEnd="@dimen/dialog_content_padding"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_book_picker_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_book"
            android:textColor="@color/dialog_title"
            android:textSize="@dimen/dialog_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_book_picker_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_switch"
            android:textColor="@color/dialog_subtitle"
            android:textSize="@dimen/dialog_subtitle_size" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_books"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
