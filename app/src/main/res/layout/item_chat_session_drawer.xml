<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/layout_session_actions"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btn_session_rename"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_chat_session_action_edit"
            android:clickable="true"
            android:contentDescription="rename"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_chat_edit"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_session_delete"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_session_action_delete"
            android:clickable="true"
            android:contentDescription="delete"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_delete"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_session_foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="70dp"
        android:background="@drawable/bg_chat_session_item"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1C2E4A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="#1C2E4A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_session_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A97AB"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tv_session_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8A97AB"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
