<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/chat_session_item_spacing"
    android:clipChildren="true"
    android:clipToPadding="true">

    <LinearLayout
        android:id="@+id/layout_session_actions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_chat_session_actions_track"
        android:gravity="center_vertical|end"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_session_rename"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_session_action_edit"
            android:clickable="true"
            android:contentDescription="rename"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_chat_edit"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_session_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chat_session_action_delete"
            android:clickable="true"
            android:contentDescription="delete"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_session_foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_session_item"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chat_ai_bubble_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="@color/chat_ai_bubble_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_session_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chat_bill_detail_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_session_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/chat_time_chip_text"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
