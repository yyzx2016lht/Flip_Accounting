<?xml version="1.0" encoding="utf-8"?>
<!-- AI 消息气泡（左侧） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tv_ai_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chat_time_chip"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#6F8099"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start">

    <!-- 多选复选框 -->
    <CheckBox
        android:id="@+id/cb_ai_text_select"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="4dp"
        android:clickable="false"
        android:focusable="false" />

    <!-- AI 头像 -->
    <ImageView
        android:id="@+id/iv_ai_avatar_msg"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_ai_default_avatar"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_soft"
        android:layout_gravity="top"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="280dp">

        <TextView
            android:id="@+id/tv_ai_name_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="2dp"
            android:visibility="gone" />

        <!-- 文字气泡 -->
        <TextView
            android:id="@+id/tv_ai_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="292dp"
            android:background="@drawable/bg_chat_bubble_ai"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textSize="15sp"
            android:textColor="#2A364A"
            android:lineSpacingExtra="2dp"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:hyphenationFrequency="full"
            android:visibility="visible" />

        <!-- 加载中动画 -->
        <LinearLayout
            android:id="@+id/layout_ai_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chat_bubble_ai"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone">
            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="#999999"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tv_ai_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在思考..."
                android:textSize="13sp"
                android:textColor="#999999" />
        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

</LinearLayout>
