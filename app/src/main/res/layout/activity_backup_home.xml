<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page_bg"
    android:orientation="vertical">

    <com.taostudio.tapaccounting.ui.widget.SecondaryPageHeaderView
        android:id="@+id/secondary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="备份与恢复" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="#DEE6F2"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快速操作"
                        android:textColor="@color/settings_item_title"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_quick_actions_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="手动触发，不做后台自动同步，避免误覆盖。"
                        android:textColor="#6D7C93"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quick_local"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="本地备份"
                            android:textColor="#44556E"
                            app:backgroundTint="#EAF0FB"
                            app:cornerRadius="10dp"
                            app:icon="@android:drawable/ic_menu_save"
                            app:iconTint="#5C80EA" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quick_restore"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="导入恢复"
                            android:textColor="#44556E"
                            app:backgroundTint="#EAF0FB"
                            app:cornerRadius="10dp"
                            app:icon="@android:drawable/ic_menu_upload"
                            app:iconTint="#5C80EA" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quick_save_as"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="另存为"
                            android:textColor="#44556E"
                            app:backgroundTint="#EAF0FB"
                            app:cornerRadius="10dp"
                            app:icon="@android:drawable/ic_menu_edit"
                            app:iconTint="#5C80EA" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quick_csv"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="CSV 工具"
                            android:textColor="#44556E"
                            app:backgroundTint="#EAF0FB"
                            app:cornerRadius="10dp"
                            app:icon="@android:drawable/ic_menu_sort_by_size"
                            app:iconTint="#5C80EA" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="#DEE6F2"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本地备份设置"
                        android:textColor="@color/settings_item_title"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="管理备份模块、默认覆盖备份、另存为重命名和恢复。"
                        android:textColor="#6D7C93"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_local_backup"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="进入本地备份页面"
                        app:backgroundTint="#5C80EA"
                        app:cornerRadius="10dp"
                        app:icon="@android:drawable/ic_menu_save"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="#DEE6F2"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="云端备份设置"
                        android:textColor="@color/settings_item_title"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="配置 WebDAV（坚果云），手动上传下载，配合保留策略控制空间。"
                        android:textColor="#6D7C93"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_cloud_backup"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="进入云端同步设置"
                        app:backgroundTint="@color/brand_primary"
                        app:cornerRadius="10dp"
                        app:icon="@android:drawable/ic_menu_upload"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

