<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chat_dialog_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:text="@string/custom_reply_style"
        android:textColor="#25344A"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp"
        android:text="@string/custom_reply_hint"
        android:textColor="#8A98AD"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_custom_reply_style"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_model_search_field"
        android:gravity="top|start"
        android:hint="@string/reply_style_custom_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:textColor="#25344A"
        android:textColorHint="#9AA7BA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_custom_preview_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_action_item"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:text="@string/reply_style_custom_tip"
        android:textColor="#7E8BA0"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_custom_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dialog_action_item"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/save_and_use"
        android:textColor="#2A3A53"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_custom_turn_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dialog_action_item_danger"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="@string/disable_natural_reply"
        android:textColor="#B3261E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_custom_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="@string/cancel"
        android:textColor="#6F7E95"
        android:textSize="14sp" />

</LinearLayout>
