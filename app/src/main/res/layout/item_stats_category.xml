<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_stats_list_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/iv_category_icon"
        android:layout_width="@dimen/icon_size_32"
        android:layout_height="@dimen/icon_size_32"
        android:background="@drawable/bg_circle_soft"
        android:padding="7dp"
        android:src="@drawable/ic_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分类"
                android:textColor="#2B3445"
                android:textSize="@dimen/text_size_13" />

            <TextView
                android:id="@+id/tv_category_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="0.00%"
                android:textColor="#7F8A9F"
                android:textSize="@dimen/text_size_11" />

            <LinearLayout
                android:id="@+id/ll_comparison"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_comparison_arrow"
                    android:layout_width="@dimen/icon_size_10"
                    android:layout_height="@dimen/icon_size_10"
                    android:src="@android:drawable/arrow_up_float"
                    app:tint="#4CAF50" />

                <TextView
                    android:id="@+id/tv_comparison_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:text="¥0.00"
                    android:textColor="#4CAF50"
                    android:textSize="@dimen/text_size_11" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_category_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥0.00"
                android:textColor="#273247"
                android:textSize="@dimen/text_size_13"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/icon_size_14"
                android:layout_height="@dimen/icon_size_14"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#B0B8C8" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_category_percent"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_stats_progress" />
    </LinearLayout>

</LinearLayout>
