<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <tao.test.flipaccounting.ui.widget.SecondaryPageHeaderView
        android:id="@+id/secondary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerActionIcon="@drawable/ic_action_share"
        app:headerActionVisible="true"
        app:headerSecondaryActionIcon="@drawable/ic_action_delete"
        app:headerSecondaryActionVisible="true"
        app:headerTitle="日志查看器" />

    <!-- Tab 切换：运行日志 / 崩溃日志 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_runtime_log"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="运行日志"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4080FF"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#EEEEEE" />

        <TextView
            android:id="@+id/tab_crash_log"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="崩溃日志"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Tab 下划线指示器 -->
    <View
        android:id="@+id/tab_indicator"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginBottom="4dp"
        android:background="#4080FF" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_log_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="正在加载日志..."
            android:textColor="#444444"
            android:textSize="@dimen/text_size_12" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
