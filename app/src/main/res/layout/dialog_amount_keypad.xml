<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 金额显示区域 -->
    <EditText
        android:id="@+id/et_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="end"
        android:hint="0.00"
        android:inputType="none"
        android:padding="16dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#CCCCCC"
        android:textSize="36sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="12dp" />

    <!-- 键盘区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <!-- 第一行：7 8 9 + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="7"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="8"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="9"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key_operator"
                android:stateListAnimator="@null"
                android:text="+"
                android:textColor="#3B82F6"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第二行：4 5 6 - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="4"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="5"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="6"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_subtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key_operator"
                android:stateListAnimator="@null"
                android:text="−"
                android:textColor="#3B82F6"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第三行：1 2 3 × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="1"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="2"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="3"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key_operator"
                android:stateListAnimator="@null"
                android:text="×"
                android:textColor="#3B82F6"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第四行：0 . ⌫ ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="2"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="0"
                android:textColor="#1F2937"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_key_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key"
                android:stateListAnimator="@null"
                android:text="."
                android:textColor="#1F2937"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_key_divide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key_operator"
                android:stateListAnimator="@null"
                android:text="÷"
                android:textColor="#3B82F6"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第五行：C 删除 确定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key_delete"
                android:stateListAnimator="@null"
                android:text="C"
                android:textColor="#EF4444"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_key_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_amount_key_delete"
                android:stateListAnimator="@null"
                android:text="⌫"
                android:textColor="#EF4444"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btn_key_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/bg_amount_key_primary"
                android:stateListAnimator="@null"
                android:text="确定"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
